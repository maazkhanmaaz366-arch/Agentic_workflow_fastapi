# ==========================================================
# Environment Variables Configuration Template
# Copy this file to .env and replace placeholders with real values
# ==========================================================

# Application Metadata
PROJECT_NAME="USER MANAGEMENT SYSTEM"
VERSION="1.0.0"

# Database Configuration (MongoDB)
# Local development:
MONGO_URL="mongodb://localhost:27017/"
# Docker Compose:
# MONGO_URL="mongodb://mongodb:27017/"
DATABASE_NAME="backend_db"

# Security & JWT Authentication
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_TIME=30

# AI Agent Provider (Groq API)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
